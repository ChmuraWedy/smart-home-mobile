{
  "name": "smart-home-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "setup:dashboard": "git submodule update --init -- dashboard && pnpm --dir dashboard/frontend install --frozen-lockfile",
    "dev": "node scripts/dashboard.mjs dev",
    "build": "tsc --noEmit && node scripts/dashboard.mjs build",
    "sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "typescript": "7.0.2"
  }
}
